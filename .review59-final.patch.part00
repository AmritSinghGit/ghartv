index d2dba40652cf87bfffac2eb751fbd28931fa7b4a..0000000 100644
--- a/android-tv/app/src/main/java/in/ghartv/nova/PlayerActivity.java
+++ b/android-tv/app/src/main/java/in/ghartv/nova/PlayerActivity.java
@@ -931,10 +931,11 @@ public final class PlayerActivity extends Activity implements ChannelNavigator.Listener {
         loading.setVisibility(View.GONE);
         releasePlayer();
         String technical = diagnostic(error);
         String lower = technical.toLowerCase(Locale.ROOT);
-        boolean dns = NetworkFailure.classify(error).equals("DNS_UNAVAILABLE");
-        boolean auth = lower.contains("401") || lower.contain