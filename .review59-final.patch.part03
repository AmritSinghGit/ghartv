Equals("HTTP_STREAM_UNAVAILABLE", NetworkFailure.classifyHttpStatus(410));
+        assertEquals("HTTP_RATE_LIMITED", NetworkFailure.classifyHttpStatus(429));
+    }
+    @Test public void providerTimeoutAndServerErrorsStayDistinctFromDnsAndTls() {
+        assertEquals("HTTP_PROVIDER_TIMEOUT", NetworkFailure.classifyHttpStatus(408));
+        assertEquals("HTTP_PROVIDER_TIMEOUT", NetworkFailure.classifyHttpStatus(504));
+        assertEquals("HTTP_PROVIDER_ERROR", NetworkFailure.classifyHttpStatus(503));
+        assertEquals("DNS_UNAVAILABLE", NetworkFailure.classify(new java.net.UnknownHostException("synthetic")));
+        assertEquals("TLS_FAILED", NetworkFailure.classify(new javax.net.ssl.SSLHandshakeException("synthetic")));
+    }
+    @Test public void nonErrorHttpStatusesDoNotMasqueradeAsFailures() {
+        assertEquals("UNCLASSIFIED", NetworkFailure.classifyHttpStatus(200));
+        assertEquals("UNCLASSIFIED", NetworkFailure.classifyHttpStatus(302));
+    }
+}
