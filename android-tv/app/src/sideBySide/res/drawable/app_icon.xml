<?xml version="1.0" encoding="utf-8"?>
<!-- Test copy 'GharTV fixes': bright orange so it is never mistaken for the real GharTV icon. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="48dp" />
            <solid android:color="#FF6A00" />
        </shape>
    </item>
    <item android:left="18dp" android:right="18dp" android:top="18dp" android:bottom="18dp">
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <stroke android:width="6dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <item android:left="40dp" android:right="40dp" android:top="46dp" android:bottom="46dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
