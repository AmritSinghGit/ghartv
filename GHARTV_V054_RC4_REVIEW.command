#!/bin/bash
set -Eeuo pipefail

GHARTV_REPO="AmritSinghGit/ghartv"
GHARTV_DIR="${GHARTV_PROJECT:-$HOME/Downloads/GharTV_Nova_v0.4.2}"
GHARTV_BRANCH="main"
GHARTV_BASE="6228319fcefe0bf49685d925da426490c77f261a"
GHARTV_TAG="v0.5.4-rc4"
GHARTV_VERSION="0.5.4-rc4-family-preview"
GHARTV_PACKAGE="in.ghartv.nova"

OPERON_REPO="AmritSinghGit/operon"
OPERON_BRANCH="codex/opr-analytics-003-vcnow-data-control-convergence"
OPERON_PR="61"
OPERON_CANDIDATE="ANALYTICS-090-007"

STAMP="$(date +%Y%m%d-%H%M%S)"
RESULT="$HOME/Desktop/GharTV-v0.5.4-RC4-$STAMP"
RUN_ROOT="$HOME/.local/state/operon-terminal-runs"
mkdir -p "$RESULT" "$RUN_ROOT/ghartv" "$RUN_ROOT/operon-analytics"
LOG="$RESULT/setup.log"
exec > >(tee -a "$LOG") 2>&1

step(){ printf '\n============================================================\n%s\n============================================================\n' "$1"; }
fail(){ printf '\nERROR: %s\nEvidence: %s\n' "$1" "$RESULT" >&2; exit 1; }
sha256(){ shasum -a 256 "$1" | awk '{print $1}'; }

step "GharTV v0.5.4 RC4 — working family-preview candidate"
printf '%-25s %s\n' "Product authority:" "$GHARTV_REPO · $GHARTV_BRANCH · ghartv"
printf '%-25s %s\n' "Analytics authority:" "$OPERON_REPO · $OPERON_BRANCH · PR #$OPERON_PR"
printf '%-25s %s\n' "Stable televisions:" "remain on v0.5.3 / versionCode 10"
printf '%-25s %s\n' "Duplicate authority:" "none"
printf '%-25s %s\n' "Analytics worktree:" "optional; never blocks the Android candidate"

for cmd in git gh python3 unzip shasum rsync; do command -v "$cmd" >/dev/null || fail "$cmd is required"; done
gh auth status -h github.com >/dev/null 2>&1 || fail "GitHub CLI is not authenticated"
[ -d "$GHARTV_DIR/.git" ] || fail "Canonical GharTV checkout is missing: $GHARTV_DIR"
[ "$(git -C "$GHARTV_DIR" symbolic-ref --short HEAD)" = "$GHARTV_BRANCH" ] || fail "GharTV is not on existing main"
case "$(git -C "$GHARTV_DIR" remote get-url origin)" in *AmritSinghGit/ghartv*) ;; *) fail "Unexpected GharTV origin";; esac

TMP="$(mktemp -d "${TMPDIR:-/tmp}/ghartv-rc4.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT
GH_ZIP="$TMP/ghartv-overlay.zip"; OP_ZIP="$TMP/operon-overlay.zip"
python3 - "$GH_ZIP" <<'PY'
from pathlib import Path
import base64,sys
Path(sys.argv[1]).write_bytes(base64.b64decode(''''''))
PY
python3 - "$OP_ZIP" <<'PY'
from pathlib import Path
import base64,sys
Path(sys.argv[1]).write_bytes(base64.b64decode(''''''))
PY
[ "$(sha256 "$GH_ZIP")" = "8918dff095b302a2de6c182b232a98270b9b87d8b8c68437d4ff5a1aebaf7bb3" ] || fail "Embedded GharTV RC4 overlay checksum mismatch"
[ "$(sha256 "$OP_ZIP")" = "ae393f07ae15ab4a2f03768bd2e495e71d84a4d5ac85fa2d3f8354ccc996f43d" ] || fail "Embedded Operon tenant overlay checksum mismatch"
unzip -q "$GH_ZIP" -d "$TMP/gh"
unzip -q "$OP_ZIP" -d "$TMP/op"

step "Preserving and reconciling any bounded GharTV candidate work"
git -C "$GHARTV_DIR" fetch --no-tags origin "$GHARTV_BRANCH"
LOCAL_HEAD="$(git -C "$GHARTV_DIR" rev-parse HEAD)"; REMOTE_HEAD="$(git -C "$GHARTV_DIR" rev-parse "origin/$GHARTV_BRANCH")"
DIRTY="$RESULT/preexisting-work-preserved"; mkdir -p "$DIRTY"
git -C "$GHARTV_DIR" status --short > "$DIRTY/git-status.txt"
git -C "$GHARTV_DIR" diff --binary HEAD > "$DIRTY/tracked-work.patch" || true
printf '%s\n' "$LOCAL_HEAD" > "$DIRTY/local-head.txt"; printf '%s\n' "$REMOTE_HEAD" > "$DIRTY/remote-head.txt"
set +e
python3 - "$GHARTV_DIR" "$TMP/gh/RC4_OVERLAY_PATHS.txt" "$DIRTY" <<'PY'
from pathlib import Path
import shutil,subprocess,sys
root=Path(sys.argv[1]); allowed=set(Path(sys.argv[2]).read_text().splitlines())
allowed.update({'GHARTV_V054_RC4_REVIEW.command','GHARTV_CLOSE_RC3_REVIEW.command','GHARTV_PUBLISH_STABLE_V054_FROM_RC3.command','REVIEW_CHECKLIST_v0.5.4-rc3.md','release-notes-v0.5.4-rc3.md'})
def lines(args):
    out=subprocess.check_output(['git','-C',str(root),*args],text=True)
    return {x.strip() for x in out.splitlines() if x.strip()}
dirty=lines(['diff','--name-only'])|lines(['diff','--cached','--name-only'])|lines(['ls-files','--others','--exclude-standard'])
unknown=sorted(dirty-allowed)
preserve=Path(sys.argv[3]); (preserve/'dirty-paths.txt').write_text('\n'.join(sorted(dirty))+'\n')
for rel in sorted(dirty):
    p=root/rel
    if p.is_file() or p.is_symlink():
        q=preserve/'untracked-and-working-files'/rel; q.parent.mkdir(parents=True,exist_ok=True)
        if p.is_symlink(): q.write_text('SYMLINK -> '+str(p.readlink()))
        else: shutil.copy2(p,q)
if unknown:
    (preserve/'ACTION_REQUIRED.txt').write_text('Unrelated paths were preserved and not touched:\n'+'\n'.join(unknown)+'\n')
    print('\n'.join(unknown)); raise SystemExit(12)
print(f'Bounded reconciliation: {len(dirty)} existing candidate path(s) preserved; no unrelated path found.')
PY
RC=$?
set -e
[ "$RC" -eq 0 ] || fail "Unrelated local work exists. Read $DIRTY/ACTION_REQUIRED.txt; no reset, clean or stash was performed"

if [ "$LOCAL_HEAD" != "$REMOTE_HEAD" ]; then
  [ -z "$(git -C "$GHARTV_DIR" status --porcelain)" ] || fail "Local main is behind remote while candidate work is present; preserved without pull"
  git -C "$GHARTV_DIR" merge-base --is-ancestor "$LOCAL_HEAD" "$REMOTE_HEAD" || fail "GharTV local/remote diverged; no reset or rebase was performed"
  git -C "$GHARTV_DIR" pull --ff-only origin "$GHARTV_BRANCH"
fi
CURRENT="$(git -C "$GHARTV_DIR" rev-parse HEAD)"
if [ "$CURRENT" != "$GHARTV_BASE" ] && ! grep -Eq '0\.5\.4-rc(3|4)' "$GHARTV_DIR/android-tv/app/build.gradle.kts"; then
  fail "GharTV main moved beyond the known RC2/RC3/RC4 line; newer work was preserved"
fi

# Remove only known obsolete untracked RC3 helper files after they were preserved above.
rm -f "$GHARTV_DIR/GHARTV_CLOSE_RC3_REVIEW.command" "$GHARTV_DIR/GHARTV_PUBLISH_STABLE_V054_FROM_RC3.command" \
      "$GHARTV_DIR/REVIEW_CHECKLIST_v0.5.4-rc3.md" "$GHARTV_DIR/release-notes-v0.5.4-rc3.md"
rsync -a --exclude RC4_OVERLAY_PATHS.txt "$TMP/gh/" "$GHARTV_DIR/"
cp "$0" "$GHARTV_DIR/GHARTV_V054_RC4_REVIEW.command"; chmod +x "$GHARTV_DIR/GHARTV_V054_RC4_REVIEW.command"
(cd "$GHARTV_DIR" && bash VALIDATE_SOURCE.command)

step "Publishing the exact GharTV RC4 source"
git -C "$GHARTV_DIR" add -A
git -C "$GHARTV_DIR" diff --cached --check
if ! git -C "$GHARTV_DIR" diff --cached --quiet; then
  git -C "$GHARTV_DIR" commit -m "feat: GharTV v0.5.4 RC4 family preview"
  git -C "$GHARTV_DIR" push origin "$GHARTV_BRANCH"
fi
GH_SHA="$(git -C "$GHARTV_DIR" rev-parse HEAD)"
git -C "$GHARTV_DIR" fetch --no-tags origin "$GHARTV_BRANCH"
[ "$(git -C "$GHARTV_DIR" rev-parse "origin/$GHARTV_BRANCH")" = "$GH_SHA" ] || fail "GharTV source was not published exactly"

step "Waiting for the exact GitHub Android TV build"
GH_RUN=""
for _ in $(seq 1 40); do
  GH_RUN="$(gh run list -R "$GHARTV_REPO" --commit "$GH_SHA" --workflow "Android TV build" --json databaseId -q '.[0].databaseId' 2>/dev/null || true)"
  [ -n "$GH_RUN" ] && break
  sleep 4
done
[ -n "$GH_RUN" ] || fail "No Android TV workflow appeared for $GH_SHA"
gh run watch "$GH_RUN" -R "$GHARTV_REPO" --exit-status || fail "GitHub Android build failed for $GH_SHA"

step "Building and verifying the existing-key signed RC4 APK"
JAVA_HOME_SELECTED="/Library/Java/JavaVirtualMachines/zulu-17.jdk/Contents/Home"
[ -x "$JAVA_HOME_SELECTED/bin/java" ] || JAVA_HOME_SELECTED="$(/usr/libexec/java_home -v 17 2>/dev/null || true)"
[ -x "$JAVA_HOME_SELECTED/bin/java" ] || fail "JDK 17 was not found"
export JAVA_HOME="$JAVA_HOME_SELECTED" PATH="$JAVA_HOME_SELECTED/bin:$PATH"
SDK_ROOT="${ANDROID_SDK_ROOT:-$HOME/Library/Android/sdk}"; export ANDROID_SDK_ROOT="$SDK_ROOT" ANDROID_HOME="$SDK_ROOT"
ADB="$SDK_ROOT/platform-tools/adb"; EMULATOR="$SDK_ROOT/emulator/emulator"; [ -x "$ADB" ] || fail "adb is missing"; [ -x "$EMULATOR" ] || fail "Android Emulator is missing"
SIGNING_ENV="$HOME/Library/Application Support/GharTV/signing/signing.env"; [ -f "$SIGNING_ENV" ] || fail "Existing GharTV signing identity is missing"
# shellcheck disable=SC1090
source "$SIGNING_ENV"; export GHARTV_SIGNING_STORE GHARTV_SIGNING_STORE_PASSWORD GHARTV_SIGNING_KEY_ALIAS GHARTV_SIGNING_KEY_PASSWORD
GRADLE="$GHARTV_DIR/android-tv/gradlew"; [ -x "$GRADLE" ] || GRADLE="$HOME/Library/Caches/GharTV-Nova/gradle-8.11.1/bin/gradle"; [ -x "$GRADLE" ] || fail "Gradle 8.11.1 is missing"
export GRADLE_USER_HOME="$HOME/Library/Caches/GharTV-Nova/gradle-user-home-java17"
(cd "$GHARTV_DIR/android-tv" && "$GRADLE" --no-daemon --stacktrace --max-workers=2 -Dorg.gradle.java.home="$JAVA_HOME" :app:assembleRelease)
BUILT="$GHARTV_DIR/android-tv/app/build/outputs/apk/release/app-release.apk"; [ -f "$BUILT" ] || fail "Signed RC4 APK was not produced"
APK="$RESULT/GharTV-Jio-Live-v0.5.4-rc4.apk"; cp "$BUILT" "$APK"; APK_SHA="$(sha256 "$APK")"; printf '%s  %s\n' "$APK_SHA" "$(basename "$APK")" > "$RESULT/GharTV-Jio-Live-v0.5.4-rc4.apk.sha256"
APKSIGNER="$SDK_ROOT/build-tools/36.0.0/apksigner"; [ -x "$APKSIGNER" ] || APKSIGNER="$(find "$SDK_ROOT/build-tools" -name apksigner -type f | sort -V | tail -1)"; [ -x "$APKSIGNER" ] || fail "apksigner missing"; "$APKSIGNER" verify --verbose --print-certs "$APK" > "$RESULT/apk-signature.txt"

step "Publishing the owner-review prerelease — stable update remains unchanged"
NOTES="$GHARTV_DIR/release-notes-v0.5.4-rc4.md"
if gh release view "$GHARTV_TAG" -R "$GHARTV_REPO" >/dev/null 2>&1; then
  gh release edit "$GHARTV_TAG" -R "$GHARTV_REPO" --target "$GH_SHA" --title "GharTV Jio Live v0.5.4 RC4 — Family Preview" --prerelease --notes-file "$NOTES"
  gh release upload "$GHARTV_TAG" "$APK" "$RESULT/GharTV-Jio-Live-v0.5.4-rc4.apk.sha256" -R "$GHARTV_REPO" --clobber
else
  gh release create "$GHARTV_TAG" "$APK" "$RESULT/GharTV-Jio-Live-v0.5.4-rc4.apk.sha256" -R "$GHARTV_REPO" --target "$GH_SHA" --title "GharTV Jio Live v0.5.4 RC4 — Family Preview" --prerelease --notes-file "$NOTES"
fi
LATEST="$(gh api "repos/$GHARTV_REPO/releases/latest" --jq .tag_name)"; [ "$LATEST" = "v0.5.3" ] || fail "Stable release boundary changed unexpectedly: latest=$LATEST"
python3 - "$GHARTV_DIR/update/latest.json" <<'PY'
import json,sys
x=json.load(open(sys.argv[1])); assert x['versionCode']==10 and x['versionName']=='0.5.3-observability',x
PY

step "Opening RC4 on the existing Google TV emulator"
SERIAL=""
while IFS= read -r s; do
  [ -n "$s" ] || continue
  name="$("$ADB" -s "$s" emu avd name 2>/dev/null | tr -d '\r' | head -1 || true)"
  case "$name" in GharTV_*) SERIAL="$s"; break;; esac
done < <("$ADB" devices | awk '$2=="device"&&$1~/^emulator-/{print $1}')
if [ -z "$SERIAL" ]; then
  AVD="GharTV_Nova_Manual_google_tv_API36"
  nohup "$EMULATOR" -avd "$AVD" -port 5580 -dns-server 1.1.1.1,8.8.8.8 -no-snapshot-load > "$RESULT/emulator.log" 2>&1 &
  SERIAL="emulator-5580"; "$ADB" -s "$SERIAL" wait-for-device
  for _ in $(seq 1 180); do [ "$("$ADB" -s "$SERIAL" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r' || true)" = 1 ] && break; sleep 2; done
fi
[ "$("$ADB" -s "$SERIAL" shell pm list features | grep -c 'android.software.leanback' || true)" -gt 0 ] || fail "The target is not an Android TV/Google TV emulator"
"$ADB" -s "$SERIAL" install -r -d "$APK"
# Capture both appearances without clearing app data; leave Dad birthday mode open.
"$ADB" -s "$SERIAL" shell am force-stop "$GHARTV_PACKAGE"
"$ADB" -s "$SERIAL" shell am start -W -n "$GHARTV_PACKAGE/.MainActivity" --es ghartv_theme_preview standard
sleep 2; "$ADB" -s "$SERIAL" exec-out screencap -p > "$RESULT/standard-theme.png" || true
"$ADB" -s "$SERIAL" shell am force-stop "$GHARTV_PACKAGE"
"$ADB" -s "$SERIAL" shell am start -W -n "$GHARTV_PACKAGE/.MainActivity" --es ghartv_theme_preview birthday --es ghartv_theme_person dad
sleep 2; "$ADB" -s "$SERIAL" exec-out screencap -p > "$RESULT/dad-birthday-theme.png" || true

step "Registering the GharTV analytics tenant without requiring a local worktree"
ANALYTICS_STATUS="REMOTE_REGISTRATION_PENDING"; OP_SHA=""; ANALYTICS_URL=""
set +e
python3 - "$TMP/op" "$OPERON_REPO" "$OPERON_BRANCH" "$RESULT" <<'PY'
from pathlib import Path
import base64,json,subprocess,sys,tempfile,shutil
src=Path(sys.argv[1]); repo=sys.argv[2]; branch=sys.argv[3]; result=Path(sys.argv[4])
def run(args,input_data=None,check=True):
    p=subprocess.run(args,input=input_data,text=True,capture_output=True)
    if check and p.returncode: raise RuntimeError((p.stderr or p.stdout).strip())
    return p.stdout.strip()
def api(endpoint,method='GET',payload=None,fields=None):
    args=['gh','api','--method',method,endpoint]
    if fields:
        for k,v in fields.items(): args += ['-f',f'{k}={v}']
    if payload is not None:
        args += ['--input','-']; return run(args,json.dumps(payload))
    return run(args)
def get_json(endpoint,fields=None): return json.loads(api(endpoint,fields=fields))
ref=get_json(f'repos/{repo}/git/ref/heads/{branch}')
head=ref['object']['sha']
# Do nothing when the exact tenant candidate is already present.
ver=get_json(f'repos/{repo}/contents/capabilities/analytics/command-runtime/VERSION.json',fields={'ref':branch})
version_text=base64.b64decode(ver['content']).decode()
if 'ANALYTICS-090-007' in version_text and 'ghartv-tenant-7' in version_text:
    (result/'operon-analytics-sha.txt').write_text(head+'\n'); print('Operon tenant already registered at',head); raise SystemExit(0)
work=Path(tempfile.mkdtemp(prefix='operon-ghartv-tenant-'))
try:
    canonical=[
      'capabilities/analytics/command-runtime/operon_command_candidate_v080.py',
      'capabilities/analytics/command-runtime/static/index.html',
      'capabilities/analytics/command-runtime/VERSION.json']
    for rel in canonical:
        obj=get_json(f'repos/{repo}/contents/{rel}',fields={'ref':branch}); p=work/rel; p.parent.mkdir(parents=True,exist_ok=True); p.write_bytes(base64.b64decode(obj['content']))
    for p in src.rglob('*'):
        if p.is_file() and p.name!='apply_operon_ghartv_tenant.py':
            q=work/p.relative_to(src); q.parent.mkdir(parents=True,exist_ok=True); shutil.copy2(p,q)
    run(['python3',str(src/'apply_operon_ghartv_tenant.py'),str(work)])
    paths=canonical+[str(p.relative_to(src)) for p in src.rglob('*') if p.is_file() and p.name!='apply_operon_ghartv_tenant.py']
    paths=sorted(set(paths)); entries=[]
    for rel in paths:
        content=base64.b64encode((work/rel).read_bytes()).decode()
        blob=get_json(f'repos/{repo}/git/blobs',method='POST',payload={'content':content,'encoding':'base64'})
        entries.append({'path':rel,'mode':'100644','type':'blob','sha':blob['sha']})
    commit=get_json(f'repos/{repo}/git/commits/{head}'); tree=get_json(f'repos/{repo}/git/trees',method='POST',payload={'base_tree':commit['tree']['sha'],'tree':entries})
    new=get_json(f'repos/{repo}/git/commits',method='POST',payload={'message':'feat(analytics): register GharTV tenant observability','tree':tree['sha'],'parents':[head]})
    api(f'repos/{repo}/git/refs/heads/{branch}',method='PATCH',payload={'sha':new['sha'],'force':False})
    (result/'operon-analytics-sha.txt').write_text(new['sha']+'\n'); print('Operon tenant registered at',new['sha'])
finally:
    shutil.rmtree(work,ignore_errors=True)
PY
OP_RC=$?
set -e
if [ "$OP_RC" -eq 0 ] && [ -s "$RESULT/operon-analytics-sha.txt" ]; then
  OP_SHA="$(tr -d '\r\n' < "$RESULT/operon-analytics-sha.txt")"; ANALYTICS_STATUS="REGISTERED_ON_EXISTING_BRANCH"
  cat > "$RESULT/operon-pr-comment.md" <<EOF
## $OPERON_CANDIDATE · GharTV tenant registration without duplicate worktree

\`\`\`text
CANDIDATE_ID=$OPERON_CANDIDATE
TENANT_ID=ghartv
LANE=operon-analytics
EXACT_SHA=$OP_SHA
GHARTV_SHA=$GH_SHA
LOCAL_RUNTIME=DEFERRED_IF_CANONICAL_WORKTREE_ABSENT
OWNER_DECISION=REVIEW_PENDING
\`\`\`

The Android candidate no longer depends on local Operon materialisation. Tenant source is registered on the existing branch/PR without creating a branch or worktree. The protected collector credential remains server-side.
EOF
  gh pr comment "$OPERON_PR" -R "$OPERON_REPO" --body-file "$RESULT/operon-pr-comment.md" >/dev/null 2>&1 || true
else
  ANALYTICS_STATUS="ATTENTION_REMOTE_REGISTRATION_FAILED"; printf 'Operon tenant registration returned %s; GharTV review remains open.\n' "$OP_RC" > "$RESULT/operon-analytics-attention.txt"
fi

# Start only an already-existing, clean canonical analytics checkout. Never create one here.
for candidate in "${OPERON_ANALYTICS_DIR:-}" \
  "$HOME/projects/worktrees/AmritSinghGit/operon/operon-analytics-003-vcnow-data-control-convergence" \
  "$HOME/projects/operon" "$HOME/Downloads/operon"; do
  [ -n "$candidate" ] && [ -e "$candidate/.git" ] || continue
  case "$(git -C "$candidate" remote get-url origin 2>/dev/null || true)" in *AmritSinghGit/operon*) ;; *) continue;; esac
  [ "$(git -C "$candidate" symbolic-ref --short HEAD 2>/dev/null || true)" = "$OPERON_BRANCH" ] || continue
  if [ -z "$(git -C "$candidate" status --porcelain)" ]; then
    git -C "$candidate" fetch --no-tags origin "$OPERON_BRANCH" >/dev/null 2>&1 || true
    git -C "$candidate" merge-base --is-ancestor HEAD "origin/$OPERON_BRANCH" 2>/dev/null && git -C "$candidate" pull --ff-only origin "$OPERON_BRANCH" >/dev/null 2>&1 || true
    RUNTIME="$candidate/capabilities/analytics/command-runtime"
    if [ -x "$RUNTIME/run-review.command" ]; then
      set +e; OPERON_REVIEW_NONINTERACTIVE=1 bash "$RUNTIME/run-review.command"; set -e
      STATE="$HOME/Library/Application Support/Operon/operon-command-market-v0.2.0"
      [ -f "$STATE/runtime/server.url" ] && ANALYTICS_URL="$(tr -d '\r\n' < "$STATE/runtime/server.url")/ghartv-analytics.html"
    fi
  fi
  break
done
[ -n "$ANALYTICS_URL" ] && open "$ANALYTICS_URL" >/dev/null 2>&1 || true

step "Writing the existing lane receipts"
GH_NOTE="$HOME/Documents/Amrit Executive Memory/90 System/Operon Portfolio/Handoffs/Terminal Runs/ghartv/ghartv-v054-rc4-$STAMP.md"
OP_NOTE="$HOME/Documents/Amrit Executive Memory/90 System/Operon Portfolio/Handoffs/Terminal Runs/operon-analytics/analytics-090-007-ghartv-$STAMP.md"
mkdir -p "$(dirname "$GH_NOTE")" "$(dirname "$OP_NOTE")"
cat > "$GH_NOTE" <<EOF
# GharTV v0.5.4 RC4 · Family Preview
- Lane/entity: ghartv · independent project
- Repository/branch: $GHARTV_REPO · main
- Exact candidate SHA: $GH_SHA
- Signed APK SHA-256: $APK_SHA
- Prerelease: https://github.com/$GHARTV_REPO/releases/tag/$GHARTV_TAG
- Emulator: $SERIAL
- Stable update retained: v0.5.3 / versionCode 10
- Birthday mappings: Mom 4 Jan; Amrit 7 Mar; Harjas 1 Jul; Wifey 18 Aug; Sis 22 Aug; Dad 12 Sep; Simrath 4 Oct
- Owner decision: REVIEW_PENDING
EOF
cat > "$OP_NOTE" <<EOF
# $OPERON_CANDIDATE · GharTV tenant
- Lane: operon-analytics
- Existing repository/branch/PR: $OPERON_REPO · $OPERON_BRANCH · #$OPERON_PR
- Exact candidate SHA: ${OP_SHA:-NOT_UPDATED}
- Status: $ANALYTICS_STATUS
- Local runtime: ${ANALYTICS_URL:-DEFERRED_NO_CANONICAL_WORKTREE}
- No branch/worktree/database/control-surface duplicate was created.
EOF
command -v amrit-context >/dev/null 2>&1 && { amrit-context handoff --file "$GH_NOTE" >/dev/null 2>&1 || true; amrit-context handoff --file "$OP_NOTE" >/dev/null 2>&1 || true; }

HANDOFF="$RESULT/PASTE_TO_CHAT.txt"
cat > "$HANDOFF" <<EOF
GHARTV_V054_RC4_FAMILY_PREVIEW_REVIEW
LANE_ID=ghartv
ENTITY_TYPE=project
REPOSITORY=$GHARTV_REPO
BRANCH=main
PACKAGE=$GHARTV_PACKAGE
VERSION=$GHARTV_VERSION
STATUS=REVIEW_READY
OWNER_DECISION=REVIEW_PENDING
CANDIDATE_SHA=$GH_SHA
APK_SHA256=$APK_SHA
EMULATOR_SERIAL=$SERIAL
PRERELEASE_URL=https://github.com/$GHARTV_REPO/releases/tag/$GHARTV_TAG
BIRTHDAY_PREVIEW=dad-open
STANDARD_PREVIEW_COMMAND=$GHARTV_DIR/GHARTV_OPEN_STANDARD_PREVIEW.command
FAMILY_BIRTHDAY_COMMAND=$GHARTV_DIR/GHARTV_OPEN_BIRTHDAY_PREVIEW.command
OPERON_ANALYTICS_CANDIDATE=$OPERON_CANDIDATE
OPERON_ANALYTICS_SHA=${OP_SHA:-NOT_UPDATED}
OPERON_ANALYTICS_STATUS=$ANALYTICS_STATUS
OPERON_ANALYTICS_URL=${ANALYTICS_URL:-DEFERRED_NO_CANONICAL_WORKTREE}
STABLE_UPDATE=0.5.3 / versionCode 10
RESULTS=$RESULT
NEXT_ACTION=Review restored vertical preview tile, corrected birthday themes, voice/programme search, scoped channel surfing and capability-gated transport; publish stable only after explicit approval.
EOF
cp "$HANDOFF" "$RUN_ROOT/ghartv/ghartv-v054-rc4-$STAMP.txt"
cp "$HANDOFF" "$RUN_ROOT/operon-analytics/analytics-090-007-ghartv-$STAMP.txt"

step "GharTV RC4 is open for review"
cat "$HANDOFF"
printf '\nPress Enter to copy this handoff: '; IFS= read -r _; pbcopy < "$HANDOFF" 2>/dev/null || true
printf 'Copied. Press Enter to close this terminal; the GharTV emulator remains open: '; IFS= read -r _
