#!/bin/bash
# GHARTV_CODE24_OWNER_WAIVED_PUBLICATION_V1 — exact installed APK, no QEMU or app build.
set -euo pipefail
umask 077
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
export PYTHONDONTWRITEBYTECODE=1
work="$(mktemp -d "${TMPDIR:-/tmp}/ghartv-publish24.XXXXXX")"
finish(){ cd /; rm -rf -- "$work"; }
trap finish EXIT
printf '\nGharTV · publish exact code24 · local review waived by owner · rollback prepared first\n'
python3 - "$work" <<'PY_PAYLOAD'
from pathlib import Path
import base64,lzma,hashlib,json,sys
payload=base64.b64decode('',validate=True)
assert hashlib.sha256(payload).hexdigest()=='45590c3ee97f29717b1be1b31c881e511f30ee2c5eb48d19d06319e7ab5cccfe'
files=json.loads(lzma.decompress(payload))
assert set(files)=={'publish_code24.py','GharTVApkVerifier.java','ROLLBACK_RESERVE.json'}
root=Path(sys.argv[1]);assert root.is_dir() and not root.is_symlink()
for name,text in files.items():
 p=root/name;p.write_text(text);p.chmod(0o600)
PY_PAYLOAD
python3 "$work/publish_code24.py" "${1:-publish}"
