# GharTV web gate settings. Copy to ~/operon-desk/ghartv-gate.env, chmod 600, replace the REPLACE values.
# From the Cloudflare Access application for ghartv.vcnow.in (Zero Trust > Access > Applications):
ACCESS_TEAM=https://REPLACE.cloudflareaccess.com
ACCESS_AUD=REPLACE_WITH_APPLICATION_AUDIENCE_AUD_TAG
# Named household emails, comma separated (the same list as the Access policy):
ALLOWED_EMAILS=REPLACE@example.com
PUBLIC_ORIGIN=https://ghartv.vcnow.in
