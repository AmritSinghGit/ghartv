# GharTV web gate settings (not secrets; the file is kept at mode 600 anyway).
# Copy to ~/operon-desk/ghartv-gate.env (desk card ghartv-gate-1 does it), then replace the three REPLACE values.
# Infra's Access card prints all three; they are also in Cloudflare Zero Trust:
# ACCESS_TEAM: the team domain, exactly https://NAME.cloudflareaccess.com (no path, no trailing slash)
#   (Zero Trust > Settings > Custom Pages / team domain).
ACCESS_TEAM=https://REPLACE.cloudflareaccess.com
# ACCESS_AUD: the Audience (AUD) tag of the ghartv.vcnow.in application
#   (Zero Trust > Access > Applications > ghartv.vcnow.in > Overview > Application Audience (AUD) Tag).
ACCESS_AUD=REPLACE_WITH_APPLICATION_AUDIENCE_AUD_TAG
# ALLOWED_EMAILS: the household emails, lower case, comma separated, no spaces; the SAME list as the Access policy.
ALLOWED_EMAILS=REPLACE@example.com
PUBLIC_ORIGIN=https://ghartv.vcnow.in
