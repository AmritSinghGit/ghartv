diff --git a/android-tv/app/src/androidTest/java/in/ghartv/nova/Review62JioMediaDnsDiagnosticsTest.java b/android-tv/app/src/androidTest/java/in/ghartv/nova/Review62JioMediaDnsDiagnosticsTest.java
